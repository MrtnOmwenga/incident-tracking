# Copy to .env and fill in. Never commit .env.

# Database passwords (any long random strings, e.g. `openssl rand -hex 16`).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# development | test | production
LIGHTHOUSE_ENV=development
PUBLIC_URL=http://localhost:8080
OWNER_NAME=Lighthouse

# Owner sign-in without GitHub, for local development only (refused in production).
DEV_LOGIN=true

# Owner sign-in with GitHub: create an OAuth app with the callback <PUBLIC_URL>/auth/github/callback.
# OWNER_GITHUB_ID is your numeric user ID (https://api.github.com/users/<login>), the only account admitted.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_ID=

# Behind Cloudflare: CF-Connecting-IP. Leave empty unless every request passes through that proxy.
CLIENT_IP_HEADER=

# The portfolio's content: site.yaml, stories/ and media/ (compose mounts ./deploy/site by default).
SITE_DIR=
