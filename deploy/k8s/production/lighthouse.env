LIGHTHOUSE_ENV=production
# The site's address; ${DOMAIN} in the site content (demo links) is this URL's host.
PUBLIC_URL=https://martinomwenga.com
OWNER_NAME=Martin Omwenga
# Behind Cloudflare, the visitor's address arrives in this header (used for rate limits and the
# daily visitor hash; never stored).
CLIENT_IP_HEADER=CF-Connecting-IP
CHECK_WORKERS=8
SANDBOX_LIMIT_PER_HOUR=6
# The owner's GitHub sign-in (the client secret is in the lighthouse-app secret).
GITHUB_CLIENT_ID=Ov23li4mZRn5oZqUztsa
OWNER_GITHUB_ID=103695661
# Email alerts (credentials in the lighthouse-app secret). Leave ALERT_TO empty to switch them off.
SMTP_HOST=
SMTP_PORT=587
ALERT_FROM=
ALERT_TO=
