# Copy to backend.hcl (git-ignored) and fill in. OCI Object Storage's S3-compatible endpoint:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Credentials: a Customer Secret Key (Identity > Users > Customer secret keys), exported as
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY when running terraform.
bucket                      = "lighthouse-terraform"
key                         = "lighthouse/terraform.tfstate"
region                      = "eu-frankfurt-1"
endpoints                   = { s3 = "https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com" }
skip_region_validation      = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
use_lockfile                = true
