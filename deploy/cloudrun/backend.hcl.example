# Copy to backend.hcl (git-ignored). Same OCI bucket as the k3s stack, its own key.
bucket                      = "lighthouse-terraform"
key                         = "lighthouse/cloudrun.tfstate"
region                      = "eu-stockholm-1"
endpoints                   = { s3 = "https://<namespace>.compat.objectstorage.<region>.oraclecloud.com" }
skip_region_validation      = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
use_lockfile                = true
